    "postgres",
    "sqlite"
  ],
  "ci_choice": [
    "github",
    "woodpecker",
    "none"
  ],
  "api_only": false,
  "use_tailwind": false,
  "use_pwa": false,
  "use_nats": false,
  "embed_nats": false,
  "use_river": true,
  "_copy_without_render": [
    ".github/workflows/*",
    "docker/*",
    "assets/static/js/*",
    "assets/static/sw.js"
  ]
