#----------------------------------------
# App
#----------------------------------------
CGO_ENABLED=0
# Set to "production" in a deployment: it turns the development-friendly
# defaults below into hard startup errors.
APP_ENV=development

#----------------------------------------
# Server
#----------------------------------------
SERVER_PORT=9898
SERVER_TIMEOUT_READ=5s
SERVER_TIMEOUT_WRITE=10s
SERVER_TIMEOUT_IDLE=15s
X_API_KEY=changeme

#----------------------------------------
# Logging
#----------------------------------------
LOG_LEVEL=debug
LOG_JSON=false
LOG_CONCISE=false
LOG_REQUEST_HEADERS=true
LOG_RESPONSE_HEADERS=false

#----------------------------------------
# Rate Limiter
#----------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=10
RATE_LIMIT_BACKOFF=20s

{% if cookiecutter.database_choice == 'postgres' -%}
#----------------------------------------
# Database
#----------------------------------------
# Leave DATABASE_URL empty in development: with EMBEDDED_POSTGRES=true the app
# runs its own Postgres and fills this in at boot. Set it in a deployment and
# the embedded instance is skipped entirely.
DATABASE_URL=
DATABASE_MAX_CONNS=10

EMBEDDED_POSTGRES=true
# Not under tmp/ — that is air's scratch directory, and a rebuild there would
# delete the dev database.
EMBEDDED_POSTGRES_DIR=./.data/postgres
EMBEDDED_POSTGRES_PORT=5433
{% else -%}
#----------------------------------------
# SQLite
#----------------------------------------
DATABASE_URL=database/data.db
DATABASE_CONNECTION_CONTEXT=15s

#----------------------------------------
# Litestream
#----------------------------------------
LITESTREAM_LOCAL_DB_PATH=./database/data.db
DB_SYNC_INTERVAL=10s
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_DB_URL=s3://
{% endif -%}
{% if not cookiecutter.api_only %}
#----------------------------------------
# Sessions and CSRF
#----------------------------------------
SESSION_LIFETIME=168h
# Must be true anywhere the site is served over HTTPS.
SESSION_COOKIE_SECURE=false
# Comma-separated scheme://host list of cross-origin sites allowed to submit
# to this app. Same-origin requests never need listing. Required in production.
TRUSTED_ORIGINS=
{% endif -%}
{% if cookiecutter.use_river %}
#----------------------------------------
# Background jobs
#----------------------------------------
{% if not cookiecutter.api_only -%}
# Serve the job dashboard from this binary. It can cancel and retry jobs and
# nothing authorises it yet, so leave it off until the mount site in
# internal/server/routes.go is behind this app's admin check.
RIVER_UI_EMBEDDED=false
# Where it mounts. Must not overlap /app, /static or the API paths.
RIVER_UI_PATH=/riverui
{% endif -%}
{% endif -%}
{% if cookiecutter.use_nats %}
#----------------------------------------
# NATS
#----------------------------------------
{% if not cookiecutter.embed_nats -%}
NATS_URL=nats://localhost:4222
{% endif -%}
NATS_TIMEOUT=10s
{% if cookiecutter.embed_nats -%}
NATS_STORE_DIR=data/jetstream
NATS_EMBED_PORT=0
{% endif -%}
{% endif -%}
