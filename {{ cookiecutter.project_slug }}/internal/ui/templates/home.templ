package templates

templ Home(v HomeView) {
	@Layout(v.Title) {
		<h1>{ v.Title }</h1>
		if v.Flash != "" {
			<p class="flash" role="status">{ v.Flash }</p>
		}
		<p>
			This page is rendered with templ and updated in place by Datastar.
			Submitting the form below patches only the list, without a reload.
		</p>
		<form data-on-submit="@post('/app/examples', {contentType: 'form'})">
			<label for="text">New example</label>
			<input id="text" name="text" type="text" autocomplete="off" required/>
			<button type="submit">Add</button>
		</form>
		@ExampleList(v.Items, "")
	}
}

// ExampleList is patched on its own by the create handler, so it carries the
// id Datastar targets. Rendering it standalone must produce the same markup as
// rendering it inside Home.
templ ExampleList(items []ExampleView, problem string) {
	<section id="examples">
		if problem != "" {
			<p class="error" role="alert">{ problem }</p>
		}
		if len(items) == 0 {
			<p class="empty">Nothing here yet.</p>
		} else {
			<ul>
				for _, item := range items {
					<li data-example-id={ item.ID }>{ item.Text }</li>
				}
			</ul>
		}
	</section>
}
