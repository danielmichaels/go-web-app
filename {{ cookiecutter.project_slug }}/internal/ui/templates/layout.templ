package templates

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
{% if cookiecutter.use_tailwind -%}
			<link rel="stylesheet" href="/static/css/main.css"/>
{% else -%}
			@styles()
{% endif -%}
{% if cookiecutter.use_pwa -%}
			<link rel="manifest" href="/manifest.json"/>
			<meta name="theme-color" content="#111418"/>
{% endif -%}
			<script type="module" src="/static/js/datastar.js"></script>
		</head>
		<body>
			<div class={ classShell }>
				<header class={ classTopbar }>
					<a class={ classBrand } href="/app">{{ cookiecutter.project_name }}</a>
					<nav>
						<a class={ classNavLink } href="/app/welcome">Tour</a>
						<a class={ classNavLink } href="/docs">API</a>
					</nav>
				</header>
				{ children... }
			</div>
		</body>
	</html>
}
{% if not cookiecutter.use_tailwind %}

// styles is the whole stylesheet, inline. Keeping it here rather than in a
// served file means there is no second request to get wrong and no build step
// between editing a rule and seeing it. Swap it for a linked file once it
// outgrows one screen.
templ styles() {
	<style>
		:root {
			--bg: #fbfbfa;
			--surface: #ffffff;
			--border: #e3e2df;
			--text: #1b1d1e;
			--muted: #6b6f72;
			--accent: #2f6f5e;
			--accent-soft: #e7efec;
			--error: #9a2c2c;
			--radius: 8px;
			--mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
		}

		@media (prefers-color-scheme: dark) {
			:root {
				--bg: #131516;
				--surface: #1b1e1f;
				--border: #2e3233;
				--text: #e8e6e3;
				--muted: #9aa0a3;
				--accent: #6cc0a5;
				--accent-soft: #1c2a27;
				--error: #e08585;
			}
		}

		*, *::before, *::after { box-sizing: border-box; }

		body {
			margin: 0;
			background: var(--bg);
			color: var(--text);
			font: 16px/1.6 ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
			-webkit-font-smoothing: antialiased;
		}

		a:focus-visible,
		.input:focus-visible,
		.button:focus-visible {
			outline: 2px solid var(--accent);
			outline-offset: 2px;
		}

		.shell {
			display: flex;
			flex-direction: column;
			gap: 2.5rem;
			max-width: 56rem;
			margin: 0 auto;
			padding: 2rem 1.25rem 5rem;
		}

		.topbar {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 1rem;
			padding-bottom: 1rem;
			border-bottom: 1px solid var(--border);
		}

		.brand {
			font-weight: 640;
			letter-spacing: -0.015em;
			color: var(--text);
			text-decoration: none;
		}

		.navlink {
			margin-left: 1rem;
			font-size: 0.875rem;
			color: var(--muted);
			text-decoration: none;
		}

		.navlink:hover { color: var(--accent); }

		.section {
			display: flex;
			flex-direction: column;
			gap: 1rem;
		}

		.eyebrow {
			font-family: var(--mono);
			font-size: 0.7rem;
			letter-spacing: 0.12em;
			text-transform: uppercase;
			color: var(--muted);
		}

		.title {
			margin: 0;
			font-size: 1.75rem;
			font-weight: 660;
			letter-spacing: -0.025em;
			text-wrap: balance;
		}

		.subtitle {
			margin: 0;
			font-size: 1.05rem;
			font-weight: 620;
			letter-spacing: -0.01em;
		}

		.lead {
			margin: 0;
			max-width: 34rem;
			color: var(--muted);
		}

		.link {
			color: var(--accent);
			text-underline-offset: 2px;
		}

		.grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
			gap: 0.75rem;
		}

		.card {
			display: flex;
			flex-direction: column;
			gap: 0.5rem;
			padding: 1rem;
			background: var(--surface);
			border: 1px solid var(--border);
			border-radius: var(--radius);
		}

		.card-head {
			display: flex;
			align-items: baseline;
			justify-content: space-between;
			gap: 0.75rem;
		}

		.card-name {
			margin: 0;
			font-size: 0.95rem;
			font-weight: 620;
			letter-spacing: -0.01em;
		}

		.card-body {
			margin: 0;
			font-size: 0.875rem;
			color: var(--muted);
		}

		.card-link {
			font-size: 0.875rem;
			color: var(--accent);
			text-decoration: none;
		}

		.card-link:hover { text-decoration: underline; }

		.tag {
			padding: 0.15rem 0.4rem;
			font-family: var(--mono);
			font-size: 0.68rem;
			white-space: nowrap;
			color: var(--accent);
			background: var(--accent-soft);
			border-radius: 4px;
		}

		.form {
			display: flex;
			flex-wrap: wrap;
			align-items: flex-end;
			gap: 0.5rem;
			margin: 0;
		}

		.label {
			flex: 0 0 100%;
			font-size: 0.8rem;
			font-weight: 560;
		}

		.input {
			flex: 1 1 12rem;
			min-width: 0;
			padding: 0.5rem 0.65rem;
			font: inherit;
			color: var(--text);
			background: var(--surface);
			border: 1px solid var(--border);
			border-radius: 6px;
		}

		/* Outside the row-direction form, flex-basis would set the height. */
		.input.full {
			flex: 0 0 auto;
			width: 100%;
		}

		.button {
			padding: 0.5rem 1rem;
			font: inherit;
			font-weight: 560;
			color: var(--bg);
			background: var(--accent);
			border: 1px solid transparent;
			border-radius: 6px;
			cursor: pointer;
		}

		.button:hover { filter: brightness(1.08); }
		.button:disabled { opacity: 0.5; cursor: not-allowed; filter: none; }

		.hint {
			flex: 0 0 100%;
			font-family: var(--mono);
			font-size: 0.72rem;
			color: var(--muted);
		}

		.hint.over { color: var(--error); }

		.list {
			margin: 0;
			padding: 0;
			list-style: none;
			overflow: hidden;
			background: var(--surface);
			border: 1px solid var(--border);
			border-radius: var(--radius);
		}

		.item { padding: 0.6rem 0.8rem; }
		.item + .item { border-top: 1px solid var(--border); }

		.empty {
			margin: 0;
			padding: 1.25rem;
			text-align: center;
			color: var(--muted);
			border: 1px dashed var(--border);
			border-radius: var(--radius);
		}

		.flash,
		.error {
			margin: 0;
			padding: 0.5rem 0.75rem;
			background: var(--surface);
			border-left: 3px solid var(--accent);
			border-radius: 6px;
		}

		.error {
			color: var(--error);
			border-left-color: var(--error);
		}

		.dot {
			display: inline-block;
			width: 0.5rem;
			height: 0.5rem;
			margin-right: 0.4rem;
			background: var(--accent);
			border-radius: 50%;
			animation: pulse 2s ease-in-out infinite;
		}

		@keyframes pulse {
			50% { opacity: 0.35; }
		}

		@media (prefers-reduced-motion: reduce) {
			.dot { animation: none; }
		}
	</style>
}
{% endif %}
